# Optional override for the Vite base path.
# Leave unset for the defaults:
#   npm run dev    -> /
#   npm run build  -> /zrm-coaching-prototype/
#   GitHub Actions -> /<repository-name>/
#
# Use a root base only if the site is served from the domain root:
# VITE_BASE_PATH=/
#
# Match the GitHub Pages project URL:
# VITE_BASE_PATH=/zrm-coaching-prototype/
